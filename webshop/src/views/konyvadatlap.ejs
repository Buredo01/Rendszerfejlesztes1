<!DOCTYPE html>
<html lang="hun">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/bootstrap/bootstrap.css"/>
    <link rel="stylesheet" href="style.css"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=star" />
    <script src="/js/jquery/jquery.js"></script>

    <title>Könyvesbolt</title>
</head>
<body>

  <style>
    .material-symbols-outlined {
      font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
      font-size: 40px;
    }

    .star:hover,
    .star:hover ~ .star,
    input[type="radio"]:checked ~ label .material-symbols-outlined
    {
    font-variation-settings: 
      'FILL' 1,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
    color: gold;
  }

    </style>

  <%- include('./ui/modal.ejs') %>
  <%- include('./ui/deleteModal.ejs') %>
  <%- include('./ui/kosarmodal.ejs') %>
  <%- include('./ui/loginmodal.ejs') %>
  <%- include('./ui/fejlec.ejs') %>
  <div class="container px-4" style="margin-top: 60px;">
    <div class="row gx-5">
        <div class="col-12 col-md-6">
            <img src="<%= konyv.borito%>" class="img img-fluid w-75" alt="x">

            <div class='row' style="margin-top: 30px;">
              <div class='col-5'>
                <% if(isAuthenticated && user.pozicio_id == 2){ %>
                  <form method='POST' style="margin-bottom: 25px;" id="deleteForm">
                    <input type="hidden" name="isbn" id="isbn" value="<%= konyv.isbn %>">
                    <button type="submit" style="background: none; border: none; display: inline;">
                      <img src="css/bootstrap/trash.svg" alt="Törlés" width="40" height="34" style="margin-right: 10px;">
                    </button>
                    
                    <a class="navbar-brand" href="<%= '/konyvmodositas?isbn=' +  konyv.isbn %>" target="_blank">
                      <img src="css/bootstrap/pen.svg" alt="Szerkesztés" width="40" height="34">
                    </a>
                  </form>
                  </form>
                <% } %>
                <!--
                  <div class="d-flex flex-row align-items-center">
                  <a class="navbar-brand" href="" style="margin-top: 30px;">
                  <img src="css/bootstrap/star.svg" alt="Szerkesztés" width="40" height="34">
                </a>
                <a class="navbar-brand" href="" style="margin-top: 30px;">
                  <img src="css/bootstrap/star.svg" alt="Szerkesztés" width="40" height="34">
                </a>
                <a class="navbar-brand" href="" style="margin-top: 30px;">
                  <img src="css/bootstrap/star.svg" alt="Szerkesztés" width="40" height="34">
                </a>
                <a class="navbar-brand" href="" style="margin-top: 30px;">
                  <img src="css/bootstrap/star.svg" alt="Szerkesztés" width="40" height="34">
                </a>
                <a class="navbar-brand" href="" style="margin-top: 30px;">
                  <img src="css/bootstrap/star.svg" alt="Szerkesztés" width="40" height="34">
                </a>
                  </div>-->
              </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="p-3">
              <div>
                <h1><%= konyv.cim%></h1>
                <p style="display: block; margin: 10px 0; font-size: 20px;"><%= konyv.szerzo%></p>
              </div>

              <br>

              <p style="display: block; margin: 10px 0; font-size: 20px;"><strong>ISBN: </strong><%= konyv.isbn%></p>
              <p style="display: block; margin: 10px 0; font-size: 20px;"><strong>Műfaj: </strong>
                <% if(mufajok.length > 0) { 
                  for(let i=0; i < mufajok.length; i++ ){ %>
                   <%= mufajok[i].megnevezes %>
                 <% } 
                } else { %>
                 Nincs
              <% }%>
              </p>
              <p style="display: block; margin: 10px 0; font-size: 20px;"><strong>Kiadó: </strong><%= kiado %></p>
              <p style="display: block; margin: 10px 0; font-size: 20px;"><strong>Kiadás éve: </strong><%= konyv.megjelenesEve%></p>
              <p style="display: block; margin: 10px 0; font-size: 20px;"><strong>Raktáron elérhető darabszám: </strong><%= konyv.darab%></p>

              <br>

              <p style="display: block; margin: 10px 0; font-size: 20px;"><strong>Leírás: </strong>  <%= konyv.leiras%></p>

              <br>

              <h1><%= konyv.ar.toLocaleString('hu-HU')%> Ft</h1>
              <form action="/kosarbarak" method="get" target="hiddenFrame" onsubmit="return handleFormSubmit(event);">
                <input type="hidden" name="id" value="<%= konyv.isbn %>">
                <input type="number" name="mennyiseg" min="1" value="1" class="form-control mb-2">
                <button type="submit" id="kosarbagomb" class="btn btn-primary">Kosárba</button>
            </form>
            <iframe name="hiddenFrame" style="display: none;"></iframe>

              <% if(!isAuthenticated || !user.kivansag_lista.includes( konyv.isbn )){ %>
              <a class="navbar-brand" href="/kedveles?id=<%= konyv.isbn%>">
                <img src="css/bootstrap/heart.svg" alt="Kívánságlistára" width="40" height="34" style="margin-top: 10px;">
              </a>
              <% } else { %>
                <a class="navbar-brand" href="/kedvelestorlese?id=<%= konyv.isbn%>">
                  <img src="css/bootstrap/heart-fill.svg" alt="Kívánságlistáról levesz" width="40" height="34" style="margin-top: 10px;">
                </a>
              <% } %>
            </div>
        </div>
    </div>
  </div>

  <div class="container px-4" style="margin-top: 60px;">
    <div class="row gx-2">
      <div class="col">
        <div class='row' style="margin-top: 30px;">
          <h2 style="margin-bottom: 20px;">Értékelés:</h2>
          <div class='col'>
            <form action="/ujErtekeles" method="post">
              <div class="mb-4 text-center">
              <div class="input-group">
                <div class="d-flex flex-row justify-content-center">
                  <input type="radio" class="starrating" id="1" name="rating" value="1" style="position: absolute; opacity: 0; width: 0; height: 0;">
                  <label for="1" class="star" style="cursor: pointer;">
                    <span class="material-symbols-outlined" alt="csillag 1">star</span>
                  </label>
                
                  <input type="radio" id="2" class="starrating" name="rating" value="2" style="position: absolute; opacity: 0; width: 0; height: 0;">
                  <label for="2" class="star" style="cursor: pointer;">
                    <span class="material-symbols-outlined" alt="csillag 2">star</span>
                  </label>
                    
                  <input type="radio" id="3" class="starrating" name="rating" value="3" style="position: absolute; opacity: 0; width: 0; height: 0;">
                  <label for="3" class="star" style="cursor: pointer;">
                    <span class="material-symbols-outlined" alt="csillag 3">star</span>
                  </label>

                  <input type="radio" id="4" class="starrating" name="rating" value="4" style="position: absolute; opacity: 0; width: 0; height: 0;">
                  <label for="4" class="star" style="cursor: pointer;">
                    <span class="material-symbols-outlined" alt="csillag 4">star</span>
                  </label>

                  <input type="radio" id="5" class="starrating" name="rating" value="5" style="position: absolute; opacity: 0; width: 0; height: 0;">
                  <label for="5" class="star" style="cursor: pointer;">
                    <span class="material-symbols-outlined" alt="csillag 5">star</span>
                </label>
              </div>
                </div>
                <textarea name="userreview" id="userreview" class="form-control" style="height: 300px;"></textarea>
                <button style="margin-top: 30px;" type='submit' class='btn btn-lg' name='id' value='<%= konyv.isbn %>'>Értékelés beküldése</button>
              </div>
            </form>
          </div>
        </div>



        <div class="col">
          <div class='row' style="margin-top: 80px;">
            <h2 style="margin-bottom: 20px;">További értékelések:</h2>

            <br>



        <div class="all">
            <% if(ertekelesek.length > 0) { 
              for(let i=0; i < ertekelesek.length; i++ ){ %>
                <div class="velemeny">
                  <div>
                    <h3 style="margin-bottom: 0px; font-size: 22px;"><%= ertekelesek[i].felhasznalo %></h3>
                    <p><%= ertekelesek[i].csillag %></p>
                    <div style="border: 1px solid black; width: 100%;"></div>
                    <p style="font-size: 20px;"><%= ertekelesek[i].szoveg %></p>
                  </div>
                  <% if(isAuthenticated && user.pozicio_id != 1){ %>    
                    <form action="/ertekelesTorlese" method="post">
                      <input type="hidden" name="ertekeles_id" value="<%= ertekelesek[i].ertekeles_id %>" >
                      <input type="hidden" name="konyv_id" value="<%= konyv.isbn%>" >
                      <button type="submit" style="background-color: red;" class="btn btn-danger mt-2">Vélemény törlése</button>
                    </form>
                  <br>
                  <% } %>
                </div>
                <br>
              <% } 
            } else { %>
              Nincs értékelés!
            <% } %> 
          
        </div>

      </div>
    </div>

      </div>
    </div>
  </div>


  <script src="/js/deleteBook.js"></script>
  <script src="/js/kosarpopup.js"></script>


</body>
</html>