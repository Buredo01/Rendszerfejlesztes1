<!DOCTYPE html>
<html lang="hun">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="css/bootstrap/bootstrap.css"/>
    <link rel="stylesheet" href="style.css"/>
    <title>Könyvesbolt</title>
</head>
<body>

  <%- include('./ui/fejlec.ejs') %>

  <div class="container">
    <div class="row gx-5">
        <div class="col">
            <h1 style="margin-top: 20px; display: flex; flex-direction: column; align-items: center;">Bejelentkezés</h1>
            <form style = "display: flex; flex-direction: column; align-items: center;" action="/bejelentkezes_login" method="POST" >
                <label for="email" style="display: block; margin: 10px 0;"></label>
                <input  class="form-control" type="email" id="email" name="email" style="width: 50%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" required placeholder="E-mail cím">

                <label for="password" style="display: block; margin: 10px 0;"></label>
                <input  class="form-control"type="password" id="password" name="password" style="width: 50%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;" required placeholder="Jelszó">

                <input class="imputgomb" type="submit" value="Bejelentkezés" style="width: 50%; padding: 10px; border: none; border-radius: 5px; cursor: pointer; margin-top: 20px; margin-bottom: 20px;">
                <% if (systemMessage) { %>
                    <div class="alert alert-danger" style = "width: 50%;" role="alert"><%= systemMessage.toString()%></div>
                <% } %>

            </form>
        </div>
    </div>
</div>

</body>
</html>